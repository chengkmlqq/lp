API_CORS_ORIGIN_REGEX=
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=postgres
DB_SCHEMA=public
DB_USERNAME=fquiz
DB_PASSWORD=fquiz
USER_USERNAME_COLUMN=username
USER_PASSWORD_COLUMN=password_hash
USER_STATUS_COLUMN=status
FILE_VFS_ROOT=./data/vfs
MINIO_ENABLED=true
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fquiz-files
MINIO_REGION=us-east-1
JWT_SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
LLM_PROVIDER_API_KEYS=openai=sk-your-key
LLM_REQUEST_TIMEOUT_SECONDS=60
CHAT_CONTEXT_MESSAGE_LIMIT=12
CHAT_DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_TIMEZONE=Asia/Shanghai
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
SCHEDULER_EXPIRE_INTERVAL_SECONDS=60
FLOWER_API_BASE_URL=http://flower:5555
FLOWER_API_TIMEOUT_SECONDS=10
FLOWER_BASIC_AUTH=admin:admin
WORKER_REGISTRY_TTL_SECONDS=90
CELERY_WORKER_QUEUES=default,celery
PROXY_PORT=3000
FLOWER_PORT=5555
WINE_BINARY_PATH=wine
WINE_ALLOWED_ROOT=./data/wine
WINE_DEFAULT_TIMEOUT_SECONDS=300
WINE_MAX_TIMEOUT_SECONDS=1800
# LP-35 风电场计算：exe 放在 WINE_ALLOWED_ROOT/wind_farm/ 下作为受管引擎
WIND_FARM_CALC_EXECUTABLE=wind_farm/FengLiFangLei-10.exe
WIND_FARM_CALC_QUEUE=wind_farm_calc
# 三层超时：exe 软 6h / 硬 12h；Celery 软 7h / 硬 13h；Redis visibility_timeout 24h
WIND_FARM_CALC_EXE_SOFT_TIMEOUT_SECONDS=21600
WIND_FARM_CALC_EXE_HARD_TIMEOUT_SECONDS=43200
WIND_FARM_CALC_CELERY_SOFT_TIME_LIMIT=25200
WIND_FARM_CALC_CELERY_TIME_LIMIT=46800
# LP-36 / LP-53 单风机计算：独立 MATLAB Runtime R2025a 编译产物，部署在 matlab-wind worker
MATLAB_WIND_WORKER_IMAGE=crpi-u265r07n4blchcqo.cn-shanghai.personal.cr.aliyuncs.com/ck-registry/fquiz-matlab-wind-worker:r2025a
WIND_TURBINE_CALC_COMPILED_DIR=/app/matlab-wind
WIND_TURBINE_CALC_EXE=main_angle
WIND_TURBINE_CALC_LAUNCH_SCRIPT=run_main_angle.sh
WIND_TURBINE_CALC_QUEUE=matlab-wind
# 实际 Runtime 版本：LP-53 起固定为 R2025a（25.1）
WIND_TURBINE_CALC_RUNTIME_VERSION=R2025a
WIND_TURBINE_CALC_WORK_ROOT=./data/wind-turbine-calc
# 三层超时：exe 软 6h / 硬 12h；Celery 软 7h / 硬 13h
WIND_TURBINE_CALC_EXE_SOFT_TIMEOUT_SECONDS=21600
WIND_TURBINE_CALC_EXE_HARD_TIMEOUT_SECONDS=43200
WIND_TURBINE_CALC_CELERY_SOFT_TIME_LIMIT=25200
WIND_TURBINE_CALC_CELERY_TIME_LIMIT=46800
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-strong-password
DEBUG_MODE=true
POSTGRES_DB=fquiz
POSTGRES_USER=fquiz
POSTGRES_PASSWORD=fquiz
POSTGRES_PORT=5434
POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-this-in-production
# Redis 持久化策略：
# - 启用 AOF（appendonly yes）
# - 关闭 RDB 快照（save ""）
# - 即使 RDB 失败也不阻断写请求（stop-writes-on-bgsave-error no）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=300
PIP_RETRIES=20
