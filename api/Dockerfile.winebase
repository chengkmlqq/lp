# wine-base 镜像：基于现成 pywine（Python 3.10 + Wine），已包含完整的 wineboot --init
FROM tobix/pywine:3.10

# Wine 已经初始化在 /opt/wineprefix，直接使用
ENV WINEPREFIX="/opt/wineprefix" \
    XDG_RUNTIME_DIR="/tmp" \
    WINEDLLOVERRIDES="winemenubuilder.exe=d"

# 确保 d: 盘映射正确（镜像里可能已存在，保险起见）
RUN mkdir -p /opt/wineprefix/dosdevices \
    && ln -sf /app/data/wine/ATP /opt/wineprefix/dosdevices/d: 2>/dev/null || true

# 中文字体（LP-582）：worker 内 matplotlib 渲染地闪密度网格图 / 报告图需要，
# 缺少时中文标签会渲染成方框（tofu）。与 Dockerfile.base 的 fonts-noto-cjk 保持一致。
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app