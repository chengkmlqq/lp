# wine-base 镜像：基于现成 pywine（Python 3.10 + Wine），已包含完整的 wineboot --init
FROM tobix/pywine:3.10

# 安装系统依赖（与 fquiz-base 对齐）
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg2 \
        git \
        procps \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 确保 Wine 配置完整（镜像自带 wineboot --init，做 d: 盘映射）
RUN mkdir -p /root/.wine/dosdevices \
    && ln -sf /app/data/wine/ATP /root/.wine/dosdevices/d: 2>/dev/null || true

ENV WINEPREFIX="/root/.wine" \
    WINEARCH="win32" \
    XDG_RUNTIME_DIR="/tmp" \
    WINEDLLOVERRIDES="winemenubuilder.exe=d"

WORKDIR /app