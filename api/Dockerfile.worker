# Worker 镜像：二级 wine-base（含 wine）+ 业务代码。
# 跑 celery worker：fl_analysis ATP 仿真、wine 执行等所有 wine 相关任务。
# 未来新增 worker（如判别系统）可仿照本文件从 wine-base 派生。
ARG REGISTRY=crpi-u265r07n4blchcqo.cn-shanghai.personal.cr.aliyuncs.com
ARG REGISTRY_NAMESPACE=ck-registry
FROM ${REGISTRY}/${REGISTRY_NAMESPACE}/fquiz-wine-base:latest

WORKDIR /app

# Static assets (tpbig.exe, etc.) are volume-mounted at runtime
# from deploy/pro-deploy/data/app/wine/

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# 静态引擎文件（tpbig.exe + 各电压 EGM 引擎 rjtzl_egm*.exe）随镜像分发，
# 容器启动时由 entrypoint 拷到运行时卷（/app/data/wine/ATP/）。
COPY static/wine /app/static/wine

# 安装 Python 依赖（tobix/pywine:3.10 不含 LP 业务依赖）
# fonts-noto-cjk：worker 内 matplotlib 渲染地闪密度网格图需要中文字体（LP-582），
# 缺少时中文标签渲染成方框（tofu）。wine-base 若未重建，worker 自身兜底安装。
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# 2026-10-01：PIP_INDEX_URL 可传参（本机/CI 离线构建用国内源，防 pip 下载超时整轮构建失败）
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm -f /tmp/requirements.txt

COPY app ./app
# 录波 PDF 提取器：判别任务解析录波 PDF 需要，镜像内与 app 同级存在
COPY 录波 ./录波

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["celery", "-A", "app.core.celery_app.celery_app", "worker", "--loglevel=info"]
