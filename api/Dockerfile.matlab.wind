# fquiz-matlab-wind-worker image: MATLAB Runtime R2025a + 单风机计算 celery worker
#
# LP-36 / LP-53：单风机计算（main_angle / single_turbine）的编译产物要求
# MATLAB Runtime R2025a（25.1），与故障判别（r2023a）不同版本，不能复用
# fquiz-matlab-worker（matlab-diagnostics 队列）。
#
# 基础镜像 MCR_WIND_BASE_IMAGE 来自 MathWorks 官方镜像
# containers.mathworks.com/matlab-runtime:r2025a —— 33.2 无法直连 MathWorks，
# 由 GitHub Actions runner 匿名拉取后转存到 ACR：
#   ${REGISTRY}/${REGISTRY_NAMESPACE}/fquiz-matlab-runtime:r2025a
# 该官方镜像基于 Ubuntu 24.04，仅含 MCR（/opt/matlabruntime/R2025a），无 Python，
# 因此在下面补装 Python 3.12 + 业务依赖，使镜像可直接作为 celery worker 运行。
#
# - MCR：来自基础镜像（/opt/matlabruntime/R2025a）
# - 引擎：外部卷挂载到 /app/matlab-wind（含单风机编译产物与启动脚本），
#         产物改动无需重建镜像，替换部署机卷内文件即可
# - 队列：matlab-wind（仅本镜像消费，禁止与 matlab-diagnostics 串队列）

ARG REGISTRY=crpi-u265r07n4blchcqo.cn-shanghai.personal.cr.aliyuncs.com
ARG REGISTRY_NAMESPACE=ck-registry
ARG MCR_WIND_BASE_IMAGE=${REGISTRY}/${REGISTRY_NAMESPACE}/fquiz-matlab-runtime:r2025a
FROM ${MCR_WIND_BASE_IMAGE}

ENV TZ=Asia/Shanghai
ENV DEBIAN_FRONTEND=noninteractive

# 1) Python 3.12 + 编译/运行依赖（MCR 所需 X11 库同 fquiz-mcr-base；
#    gdal-bin/libgdal-dev 供 requirements.txt 中 rasterio / GDAL 使用）
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-dev \
        build-essential \
        gdal-bin \
        libgdal-dev \
        libxt6 \
        libxmu6 \
        libice6 \
        libsm6 \
        libxrender1 \
        libxrandr2 \
        libxfixes3 \
        libxcursor1 \
        libxinerama1 \
        libxft2 \
        libxi6 \
        libgl1 \
        unzip \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 2) Python 依赖（独立 venv，避开 Ubuntu 24.04 的 PEP 668 外部管理限制）
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && GDAL_VERSION=$(gdal-config --version) \
    && pip install --no-cache-dir GDAL==${GDAL_VERSION} \
    && rm -f /tmp/requirements.txt

# 3) MCR 运行环境变量（必须在 pip/apt 之后设置，避免 MCR 库覆盖系统库）
ENV MCR_MASTER_PATH=/opt/matlabruntime/R2025a
ENV LD_LIBRARY_PATH=${MCR_MASTER_PATH}/runtime/glnxa64:${MCR_MASTER_PATH}/bin/glnxa64:${MCR_MASTER_PATH}/sys/os/glnxa64:${MCR_MASTER_PATH}/sys/opengl/lib/glnxa64
ENV XAPPLRESDIR=/etc/X11/app-defaults

# 4) 单风机编译产物的外部挂载目录
RUN mkdir -p /app/matlab-wind

WORKDIR /app
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY app ./app

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["celery", "-A", "app.core.celery_app.celery_app", "worker", "-Q", "matlab-wind", "--loglevel=info", "--concurrency=1"]
