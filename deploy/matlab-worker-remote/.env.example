# ── MATLAB 判别 Worker（分离部署）环境变量 ─────────────────────────────
# 复制为 .env 后填值；.env 不要提交到仓库（已在 .gitignore）。

# worker 镜像（CI 推的 ACR 地址；worker 机器需要先 docker login）
MATLAB_WORKER_IMAGE=crpi-u265r07n4blchcqo.cn-shanghai.personal.cr.aliyuncs.com/ck-registry/fquiz-matlab-worker:latest
# 单机并发：MATLAB 引擎吃满 CPU，默认 1；确认余量后再加
MATLAB_WORKER_CONCURRENCY=1
# 出现在 celery worker 名里，多台时区分用
WORKER_HOSTNAME=remote

# ── SSH 隧道本地端口（需与 tunnel/tunnel.env 保持一致）──
TUNNEL_MINIO_PORT=19000
TUNNEL_PG_PORT=15432
TUNNEL_REDIS_PORT=16379

# ── 33.2 上的业务库（PostgreSQL，容器名 lp-pg）──
DB_NAME=lp
DB_USERNAME=lp
DB_PASSWORD=

# ── 33.2 上的 Redis（broker 密码，即 REDIS_DSN 里的那段）──
REDIS_PASSWORD=

# ── 33.2 本机 MinIO（bucket lp-files）──
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lp-files
MINIO_REGION=us-east-1

# 若 33.2 给系统参数配了自定义加密密钥，这里必须填同一个值；
# 33.2 没配（走默认值）就保持注释，别留空字符串——空值会覆盖默认密钥导致解密报错。
# SYSTEM_PARAM_ENCRYPTION_KEY=
