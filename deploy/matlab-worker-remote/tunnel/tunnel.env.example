# SSH 隧道参数（供 lp-matlab-tunnel.service 使用）
# 端口名与 worker 的 .env 保持一致

SSH_HOST=111.170.33.2
# 外网映射端口（服务器本机 sshd 监听 22，59329 是上层网关映射）
SSH_PORT=59329
SSH_USER=root
# 建议用专用密钥：ssh-keygen -t ed25519 -f /opt/lp-worker/.ssh/lp_tunnel -N ""
SSH_KEY=/opt/lp-worker/.ssh/lp_tunnel

# 本地转发的端口（容器用 host 网络，直接 127.0.0.1 访问）
TUNNEL_MINIO_PORT=19000
TUNNEL_PG_PORT=15432
TUNNEL_REDIS_PORT=16379
