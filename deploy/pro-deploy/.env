# Compose variable defaults — override via .env.prod for production
COMPOSE_PROJECT_NAME=lp

# PostgreSQL
POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
POSTGRES_PORT=5413

# Redis
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
REDIS_PORT=6339

# MinIO
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:latest
MINIO_MC_IMAGE=docker.m.daocloud.io/minio/mc:latest
MINIO_API_PORT=7779
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=fquiz-files
MINIO_ENDPOINT=http://minio:9000

# API
API_PORT=8000

# Flower
FLOWER_PORT=5555

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Celery
CELERY_LOG_LEVEL=INFO
CELERY_TIMEZONE=Asia/Shanghai
CENTERLINE_ORDER_BUFFER=10.0

# Redis
REDIS_PASSWORD=6339
